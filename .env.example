# 配置来源二选一。
# export CLASH_URL='https://example.com/subscription?token=replace-me'
export CLASH_CONFIG_FILE='my-clash.yaml'

# Dashboard/API 密码。请替换示例值，勿提交真实密码或订阅 token。
# 留空时 start.sh 会生成随机密码并安全持久化到 .env。
export CLASH_SECRET=''

# auto: 根据 CLASH_URL/CLASH_CONFIG_FILE 选择；provider: URL 订阅；
# local-profile: 本地完整 Mihomo YAML。
export SUBSCRIPTION_MODE='auto'

# Provider 下载行为
export SUBSCRIPTION_USER_AGENT='clash-verge/v2.5.2'
export SUBSCRIPTION_INTERVAL='3600'
# 更新订阅时使用的 Mihomo 代理或策略组名称，例如 PROXY；留空表示直连。
export SUBSCRIPTION_PROXY=''
export SUBSCRIPTION_SIZE_LIMIT='10485760'

# Provider 健康检查
export HEALTH_CHECK_URL='https://cp.cloudflare.com/generate_204'
export HEALTH_CHECK_INTERVAL='300'
export HEALTH_CHECK_TIMEOUT='5000'

# Mihomo 安装与运行。MIHOMO_VERSION 应固定到经过验证的稳定版本。
# 留空时安装器默认使用项目已验证的稳定版本。
export MIHOMO_VERSION=''
export MIHOMO_SHA256=''
export MIHOMO_BINARY=''
export MIHOMO_ARCHIVE=''
export MIHOMO_CACHE_DIR=''
export MIHOMO_DOWNLOAD_PROXY=''
export MIHOMO_API_URL='http://127.0.0.1:9090'
export MIHOMO_CONTROLLER='127.0.0.1:9090'
export MIHOMO_START_TIMEOUT='10'
export MIHOMO_STOP_TIMEOUT='10'
